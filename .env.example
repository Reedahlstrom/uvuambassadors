# Copy this file to .env.local and fill it in.
# Everything is optional for local testing — with nothing set, the app runs on a
# built-in demo database with fake people and "sign in as" buttons.

# Postgres connection string (Supabase / Neon / Vercel Postgres).
# Supabase: Project → Connect → "Transaction pooler" URI (port 6543).
DATABASE_URL=

# Signs login sessions. Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# The public address of the site, used in emails and calendar links.
# Production: https://uvuambassadors.com  — leave empty when running locally.
APP_URL=

# Email (https://resend.com). Without it, emails are printed in the terminal instead.
RESEND_API_KEY=
EMAIL_FROM="UVU Ambassadors <hello@uvuambassadors.com>"

# Protects /api/cron/daily. Vercel sends it automatically once it's set in the project.
CRON_SECRET=
